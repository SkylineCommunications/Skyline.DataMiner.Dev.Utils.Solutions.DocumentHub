<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Skyline.DataMiner.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <DataMinerType>AutomationScript</DataMinerType>
    <GenerateDataMinerPackage>False</GenerateDataMinerPackage>
    <MinimumRequiredDmVersion>10.6.5.0 - 17061</MinimumRequiredDmVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Skyline.DataMiner.CICD.CSharpAnalysis.Analyzer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Skyline.DataMiner.Dev.Automation" />
    <PackageReference Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Security" />
  </ItemGroup>
  <!--
    Deliberately no reference to the DevPack (neither ProjectReference nor PackageReference): the script is shipped
    by the Storage Installer and must compile on a DMA where the DevPack DLL is not (yet) deployed. The secret-store
    primitives are compiled in from the SharedSecurity shared project instead, so script and DevPack always agree on
    the secret file layout and encryption.
  -->
  <Import Project="..\SharedSecurity\SharedSecurity.projitems" Label="Shared" />
</Project>
